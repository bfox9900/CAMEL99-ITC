
100 DIM A(100)
110 SIZ=20
120 FOR I=1 TO SIZ
130 A(I)=SIZ-I
140 NEXT I
150 GOSUB 270
160 FOR I=1 TO SIZ
170 FOR J=1 TO SIZ
180 IF A(I)>A(J)THEN 220
190 TEMP=A(I)
200 A(I)=A(J)
210 A(J)=TEMP
220 NEXT J
230 NEXT I
240 PRINT :
250 GOSUB 270
260 END
270 FOR X=1 TO SIZ
280 PRINT A(X);
290 NEXT X
300 PRINT :
310 RETURN
