\  multicolor mode  tests  2024 Brian Fox

NEEDS PLOT  FROM DSK1.GRAPHICS2
NEEDS RND   FROM DSK1.RANDOM

: ?BREAK  ?TERMINAL IF  TEXT  ABORT  THEN ;

DECIMAL
: RNDCOLOR ( -- )  14 RND 2+ 0 COLOR ;
: RNDX     ( -- n) 200 RND ;
: RNDY     ( -- n) 180 RND ;
: RNDLEN   ( -- n) 75 RND 2+ ;

: ANGLES
   CLEAR
   25 0
   DO
 \  X Y LEN        X Y LEN
    I I 200 HLINE  I I 160 VLINE
   3 +LOOP
   24 184 200 HLINE  224 24 160 VLINE
;

: DIAGONALS
    120 60
    DO
       50  20
       DO  I  I J + PLOT  LOOP
       ?BREAK
    2 +LOOP
;

: RNDLINES
    CLEAR
    40 0
    DO
      RNDX RNDY RNDX RNDY LINE
      ?BREAK
    LOOP
;

: TEST
   GRAPHICS2
   CLEAR
   PENCIL IS STYLUS
   BEGIN
      RNDCOLOR
      ANGLES BEEP
      DIAGONALS BEEP
      RNDLINES BEEP
      ?TERMINAL
   UNTIL
   TEXT ;
