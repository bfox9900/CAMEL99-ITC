* External References demo program for LINKERIII   2024 BFox

*  Instructions

* Set the /bin folder set as DSK2 in your emulator
* This file is in the /bin folder as HELLO2,A99

* With the editor assembler cartridge RUN program DSK2.LINKEXE

* The program is assembled as object file HELLO,OBJ
* It requires the external libarye DSK2.VDPLIB,OBJ
* At the Forth console type:  LINK DSK2.VDPLIB,OBJ

* Next type:  LINK DSK2.HELLO2,OBJ

*
* When linking is complete type:  HELLO RUN
*

**********************************************************************
        DEF  HELLO       * This DEF will appear in linker's DEF words

        REF  VFILL,VMBW  * External: VDPLIB,OBJ

*
* Workspace
*
WRKSP  EQU  >8300       * Workspace shared with Forth
R0LB   EQU  WRKSP+1     * R0 low byte req'd for VDP routines
BL     EQU  >2000       * 'blank" is space character

**********************
* CODE SECTION

HELLO   LWPI WRKSP
        LIMI 0

***************************
* clear the screen
PAGE    LI R0,0
        LI R1,BL
        LI R2,768
        BL @VFILL

*********************
* write the message
        LI R0,0
        LI R1,MSG1+1
        LI R2,12
        BL @VMBW

        BL @DELAY

        B *R10       * RETURN TO FORTH

**********************
* small delay sub-routine
DELAY   LI R4,>FFFF

LOOP1   DEC R4
        JNE LOOP1
        RT

**********************
* DATA SECTION
        EVEN
MSG1    BYTE 12
        TEXT 'Hello world!'
        EVEN

        END
