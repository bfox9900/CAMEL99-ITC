* External References demo program for LINKERIII   2024 BFox

*  Instructions

* This file is in the /bin  folder in TI-99 text file format.

* The object file is has been assembled as HELLO,OBJ
*
* Set the /bin folder set as DSK2 in your emulator

 * At the Forth console type:  LINK DSK2.VDPLIB,OBJ


**********************************************************************
        DEF START       * These DEFs will appear in linker's DEF words

        REF VFILL,VMBW  * External: DSK2.VDPLIB,OBJ

*
* EQUATES
*
WRKSP   EQU  >8300       * Workspace shared with Forth
BL      EQU  >2000       * 'blank" is space character
BREAK   EQU  >0020       * address of break key detector


**********************
* CODE SECTION
*
START   LWPI WRKSP
        LIMI 0

*
* clear the screen
*
PAGE    LI R0,0     * screen VDP address
        LI R1,BL    * space character
        LI R2,960   * bytes in 40 column screen
        BL @VFILL   * call video fill routine

        BL @DELAY

*
* write the message
*
        LI R0,0
        LI R1,MSG1+1
        LI R2,12
        BL @VMBW

WAIT    BL @BREAK
        JNE WAIT
        B *R10

*
* small delay sub-routine
*
DELAY   LI R4,>FFFF

LOOP1   DEC R4
        JNE LOOP1
        RT

****************
* DATA SECTION
*
        EVEN
MSG1    BYTE 12
        TEXT 'Hello world!'
        EVEN

        END
